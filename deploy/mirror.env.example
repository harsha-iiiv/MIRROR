# /etc/mirror/mirror.env: settings for the MIRROR studio live server.
# Install with: sudo install -m 600 -o root -g root deploy/mirror.env.example /etc/mirror/mirror.env
# then replace every value marked REPLACE. Restart the service after any change.

# --- Who may use the server ---------------------------------------------------
# Comma-separated browser origins allowed to call the API and open the websocket
# (the Netlify site, plus a custom domain if you add one). Nothing else is allowed.
MIRROR_CORS_ORIGINS=https://REPLACE-site-name.netlify.app

# --- Simulation ----------------------------------------------------------------
MIRROR_STUDIO_BACKEND=live
# Visitor sessions held at once; the least recently used idle one makes room.
MIRROR_MAX_SESSIONS=6
# A session idle this long (seconds) is closed.
MIRROR_SESSION_IDLE_S=1800
# Simulation jobs running at once across all visitors; others wait in line.
MIRROR_MAX_JOBS=2
# Showcase layouts per paired run (development seeds 9000-9099 only).
MIRROR_MAX_EVAL_SEEDS=6
# Worker processes per paired run; MAX_JOBS x EVAL_WORKERS should not exceed the cores.
MIRROR_STUDIO_EVAL_WORKERS=1
# Per-session scratch files (removed when a session closes).
MIRROR_STUDIO_RUNTIME=/var/lib/mirror/runtime

# --- Interpreter model -----------------------------------------------------------
# live: call the model (budgeted below); replay: recorded responses only; offline: rules only.
MIRROR_LLM_MODE=live
MIRROR_LLM_BASE_URL=https://api.meta.ai/v1
MIRROR_LLM_MODEL=muse-spark-1.3
MODEL_API_KEY=REPLACE-with-your-model-api-key
MIRROR_LLM_TIMEOUT=60
# Model requests allowed per sliding hour (whole server) and per visitor session.
# Past either limit, or on any model error, the offline interpreter is used and the page says so.
MIRROR_MODEL_CALLS_PER_HOUR=80
MIRROR_MODEL_CALLS_PER_SESSION=16

# --- Other Meta models (counted per request the studio makes) -----------------
# Past a limit the request is refused with a clear message; recordings keep working.
# One video demonstration needs, in the worst case, 10 Muse Spark grounding requests (charged to
# MIRROR_MODEL_CALLS_*, plus the proposal) and 8 SAM requests (2 cameras x video + scene parts +
# up to 2 re-seeds each). The job is refused up front unless that worst case fits; unused
# requests are given back when it finishes.
MIRROR_SAM_CALLS_PER_HOUR=24
MIRROR_SAM_CALLS_PER_SESSION=8
MIRROR_VIDEO_CALLS_PER_HOUR=12
MIRROR_VIDEO_CALLS_PER_SESSION=2
MIRROR_VOICE_CALLS_PER_HOUR=60
MIRROR_VOICE_CALLS_PER_SESSION=10

# --- Session tokens, admission and robustness (mirror/studio/admission.py, sessions.py) ------
# Sessions are bearer capabilities: id + secret token (only its hash is stored). 0 = legacy id-only.
MIRROR_REQUIRE_TOKEN=1
# Persist sessions here so they survive a restart (same id and token); unset = in memory only.
MIRROR_STUDIO_STATE=/var/lib/mirror/state
# Shared challenge records (default: <MIRROR_STUDIO_STATE>/records). Bounded; oldest evicted.
MIRROR_RECORDS_MAX=200
MIRROR_RECORDS_MAX_MB=500
# A newcomer may only displace a session idle at least this long.
MIRROR_EVICT_MIN_IDLE_S=300
# Per client address. The Origin check is not authentication; these bound what any client can do.
MIRROR_SESSIONS_PER_ADDR_HOUR=12
MIRROR_LIVE_SESSIONS_PER_ADDR=2
MIRROR_UPLOADS_PER_ADDR_HOUR=12
MIRROR_UPLOAD_MB_PER_ADDR_HOUR=200
MIRROR_JOBS_PER_ADDR_HOUR=120
MIRROR_MODEL_CALLS_PER_ADDR_HOUR=24
MIRROR_REQUESTS_PER_ADDR_MIN=300
# 1 only if your tunnel or proxy adds X-Forwarded-For (address = right-most entry). Otherwise every
# visitor arrives from 127.0.0.1 and shares one address: raise the per-address limits (0 = off).
MIRROR_TRUST_PROXY=0
# A job running longer than this is reported failed and its late result discarded.
MIRROR_JOB_TIMEOUT_S=900

# --- Uploads (mirror/studio/uploads.py): probed and fully decoded before acceptance ----------
MIRROR_UPLOAD_MAX_MB=40
MIRROR_UPLOAD_SESSION_MB=120
MIRROR_UPLOAD_GLOBAL_MB=1024
MIRROR_UPLOAD_SESSION_FILES=6
MIRROR_UPLOAD_MAX_S=90
MIRROR_UPLOAD_MAX_SIDE=1920
MIRROR_UPLOAD_MAX_PIXELS=2073600
MIRROR_UPLOAD_MAX_FPS=60
MIRROR_UPLOAD_MAX_FRAMES=5400
MIRROR_UPLOAD_PROBE_S=15
MIRROR_UPLOAD_DECODE_S=60
MIRROR_UPLOAD_MEM_MB=1536
MIRROR_UPLOAD_TTL_S=1800

# --- Consented study sessions (mirror/studio/trials.py); unset = nothing recorded ------------
# MIRROR_TRIAL_STORE=/var/lib/mirror/trials
# MIRROR_STUDY_LOG=/var/lib/mirror/study-events.jsonl
# Audio is not stored unless the participant consented AND this is > 0 (days).
MIRROR_STUDY_AUDIO_RETENTION_DAYS=0
# Optional price for cost estimates in step provenance (null when unset; never invented).
# MIRROR_LLM_USD_PER_1K_TOKENS=

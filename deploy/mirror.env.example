# /etc/mirror/mirror.env: settings for the MIRROR studio live server.
# Install with: sudo install -m 600 -o root -g root deploy/mirror.env.example /etc/mirror/mirror.env
# then replace every value marked REPLACE. Restart the service after any change.

# --- Who may use the server ---------------------------------------------------
# Comma-separated browser origins allowed to call the API and open the websocket
# (the Netlify site, plus a custom domain if you add one). Nothing else is allowed.
MIRROR_CORS_ORIGINS=https://REPLACE-site-name.netlify.app

# --- Simulation ----------------------------------------------------------------
MIRROR_STUDIO_BACKEND=live
# Visitor sessions held at once; the least recently used idle one makes room.
MIRROR_MAX_SESSIONS=6
# A session idle this long (seconds) is closed.
MIRROR_SESSION_IDLE_S=1800
# Simulation jobs running at once across all visitors; others wait in line.
MIRROR_MAX_JOBS=2
# Showcase layouts per paired run (development seeds 9000-9099 only).
MIRROR_MAX_EVAL_SEEDS=6
# Worker processes per paired run; MAX_JOBS x EVAL_WORKERS should not exceed the cores.
MIRROR_STUDIO_EVAL_WORKERS=1
# Per-session scratch files (removed when a session closes).
MIRROR_STUDIO_RUNTIME=/var/lib/mirror/runtime

# --- Interpreter model -----------------------------------------------------------
# live: call the model (budgeted below); replay: recorded responses only; offline: rules only.
MIRROR_LLM_MODE=live
MIRROR_LLM_BASE_URL=https://api.meta.ai/v1
MIRROR_LLM_MODEL=muse-spark-1.3
MODEL_API_KEY=REPLACE-with-your-model-api-key
MIRROR_LLM_TIMEOUT=60
# Model requests allowed per sliding hour (whole server) and per visitor session.
# Past either limit, or on any model error, the offline interpreter is used and the page says so.
MIRROR_MODEL_CALLS_PER_HOUR=40
MIRROR_MODEL_CALLS_PER_SESSION=8
